---
import Base from "../layouts/Base.astro";
import { getRecent, getRecentPhotos, formatDate } from "../lib/home";

const recent = await getRecent(18, 6);
const photos = await getRecentPhotos(3);

const sections = [
  { href: "/notes", title: "Notes" },
  { href: "/database", title: "Database" },
  { href: "/anatomical-atlas", title: "Atlas" },
  { href: "/tools", title: "Tools" },
  { href: "/gallery", title: "Gallery" },
];
---

<Base title="TonKurA" wide revealHeaderOnScroll>
  <section class="hero">
    <h1>TonKurA</h1>
  </section>

  <nav class="sections">
    {sections.map((s) => <a href={s.href}>{s.title}</a>)}
  </nav>

  <section class="recent">
    <h2>Recent</h2>
    <ul>
      {
        recent.map((r) => (
          <li>
            <a href={r.href}>
              <time datetime={r.date.toISOString()}>{formatDate(r.date)}</time>
              <span class="t">{r.title}</span>
              <span class="s">{r.section}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="more" href="/notes">すべて見る</a>
  </section>

  {
    photos.length > 0 && (
      <section class="photos">
        <h2>Photographs</h2>
        <div class="strip">
          {photos.map((p) => (
            <a href="/gallery">
              <img src={p.src} alt={p.description} loading="lazy" />
              <span class="cap">
                <span class="place">{p.description}</span>
                <time datetime={p.date.toISOString()}>
                  {formatDate(p.date)}
                </time>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <style>
    .hero {
      padding: 4rem 0 1.75rem;
    }
    .hero h1 {
      font-size: clamp(2.8rem, 8vw, 5rem);
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 1;
      margin: 0 0 1rem;
    }

    /* セクションは囲まない。指した1つだけ色が退いて下線が引かれる。 */
    .sections {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 2rem;
      padding: 2.5rem 0 4rem;
    }
    .sections a {
      color: var(--fg);
      font-size: clamp(1.5rem, 4vw, 2.3rem);
      font-weight: 600;
      letter-spacing: -0.035em;
      position: relative;
      transition: color 0.18s ease;
    }
    .sections a::after {
      background: currentColor;
      bottom: -0.3rem;
      content: "";
      height: 1px;
      left: 0;
      position: absolute;
      right: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.24s ease;
    }
    .sections a:hover,
    .sections a:focus-visible {
      color: var(--fg-muted);
    }
    .sections a:hover::after,
    .sections a:focus-visible::after {
      transform: scaleX(1);
    }

    h2 {
      border-bottom: 1px solid var(--border);
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-weight: 500;
      letter-spacing: 0.14em;
      margin: 0;
      padding-bottom: 0.9rem;
      text-transform: uppercase;
    }

    .recent ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .recent li a {
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      display: grid;
      gap: 1.5rem;
      grid-template-columns: 5.5rem 1fr auto;
      margin-inline: -0.75rem;
      padding: 1.05rem 0.75rem;
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .recent li a:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .recent time {
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.01em;
    }
    .recent .t {
      font-size: var(--step-0);
      line-height: 1.5;
    }
    .recent .s {
      color: var(--fg-muted);
      font-size: var(--step--1);
    }
    .more {
      color: var(--fg-muted);
      display: inline-block;
      font-size: var(--step--1);
      margin-top: 1.25rem;
    }
    .more:hover {
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .photos {
      margin-top: 4.5rem;
      padding-bottom: 2rem;
    }
    .strip {
      display: grid;
      gap: 1rem;
      grid-template-columns: 1fr;
      margin-top: 1.5rem;
    }
    @media (min-width: 48rem) {
      .strip {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .strip a {
      display: block;
    }
    .strip img {
      aspect-ratio: 3 / 2;
      background: var(--bg-subtle);
      border-radius: var(--radius);
      display: block;
      object-fit: cover;
      width: 100%;
      transition: opacity 0.2s ease;
    }
    .strip a:hover img {
      opacity: 0.85;
    }
    .cap {
      color: var(--fg-muted);
      display: flex;
      font-size: var(--step--1);
      gap: 0.75rem;
      justify-content: space-between;
      padding-top: 0.5rem;
    }
    .cap time {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    @media (max-width: 40rem) {
      .hero {
        padding-top: 2.5rem;
      }
      .sections {
        gap: 0.2rem 1.25rem;
        padding: 2rem 0 3rem;
      }
      .recent li a {
        gap: 0.3rem 1rem;
        grid-template-columns: 1fr auto;
      }
      .recent time {
        grid-column: 1;
        grid-row: 2;
      }
      .recent .t {
        grid-column: 1 / -1;
      }
      .recent .s {
        grid-column: 2;
        grid-row: 2;
      }
    }
  </style>
</Base>
