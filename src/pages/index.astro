---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { getRealQuestions } from "../lib/wiki";
import { getImagingPosts } from "../lib/imaging";

const posts = await getCollection("blog");
const imaging = await getImagingPosts();
const questions = await getRealQuestions();

const sections = [
  { href: "/wiki", title: "Wiki", count: questions.length },
  { href: "/database", title: "Database", count: null },
  { href: "/neurology", title: "Notes", count: null },
  { href: "/blog", title: "Blog", count: posts.length },
  { href: "/imaging", title: "Imaging", count: imaging.length },
  { href: "/tools", title: "Tools", count: null },
  { href: "/gallery", title: "Gallery", count: null },
];
---

<Base title="TonKurA" wide>
  <section class="hero">
    <h1>TonKurA</h1>
  </section>

  <nav class="index">
    {
      sections.map((s) => (
        <a class="row" href={s.href}>
          <span class="name">{s.title}</span>
          {s.count != null && <span class="count">{s.count}</span>}
        </a>
      ))
    }
  </nav>

  <style>
    .hero {
      min-height: 28vh;
      display: flex;
      align-items: flex-end;
    }
    .hero h1 {
      font-size: clamp(3rem, 9vw, 6rem);
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 1;
      margin: 0 0 2rem;
    }

    .index {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border);
    }
    .row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.5rem 0.75rem;
      margin-inline: -0.75rem;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .row:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .name {
      font-size: clamp(1.6rem, 4.5vw, 2.6rem);
      font-weight: 550;
      letter-spacing: -0.03em;
      line-height: 1.15;
    }
    .count {
      font-size: var(--step-0);
      color: var(--fg-muted);
      font-variant-numeric: tabular-nums;
    }
  </style>
</Base>
