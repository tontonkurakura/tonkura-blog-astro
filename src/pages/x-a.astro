---
import Base from "../layouts/Base.astro";
import { getCounts } from "../lib/home";

const c = await getCounts();

const sections = [
  { href: "/wiki", title: "Wiki", note: "勉強会で出た問いと、その答え", count: c.wiki },
  { href: "/database", title: "Database", note: "高次脳機能症候の事典", count: c.database },
  { href: "/neurology", title: "Notes", note: "神経内科の覚え書き", count: c.neurology },
  { href: "/blog", title: "Blog", note: "考えたことを長めに", count: c.blog },
  { href: "/imaging", title: "Imaging", note: "神経画像解析の方法論", count: c.imaging },
  { href: "/anatomical-atlas", title: "Atlas", note: "脳を 3D で見る", count: null },
  { href: "/tools", title: "Tools", note: "臨床スコアの計算機", count: 4 },
  { href: "/gallery", title: "Gallery", note: "写真", count: 62 },
];
---

<Base title="TonKurA" wide>
  <section class="hero">
    <h1>TonKurA</h1>
    <p class="lead">
      神経内科と神経画像のノート。臨床で引っかかったことを調べ、書き留めている。
    </p>
  </section>

  <nav class="index">
    {
      sections.map((s) => (
        <a class="row" href={s.href}>
          <span class="name">{s.title}</span>
          <span class="note">{s.note}</span>
          {s.count != null && s.count > 0 && <span class="count">{s.count}</span>}
        </a>
      ))
    }
  </nav>

  <style>
    .hero {
      padding: 4rem 0 2rem;
    }
    .hero h1 {
      font-size: clamp(3rem, 9vw, 6rem);
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 1;
      margin: 0 0 1rem;
    }
    .lead {
      color: var(--fg-muted);
      font-size: var(--step-1);
      line-height: 1.7;
      margin: 0;
      max-width: 34rem;
    }
    .index {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border);
    }
    .row {
      display: grid;
      grid-template-columns: minmax(6rem, 12rem) 1fr auto;
      align-items: baseline;
      gap: 1.5rem;
      padding: 1.25rem 0.75rem;
      margin-inline: -0.75rem;
      border-bottom: 1px solid var(--border);
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .row:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .name {
      font-size: clamp(1.4rem, 3.5vw, 2rem);
      font-weight: 550;
      letter-spacing: -0.03em;
    }
    .note {
      color: var(--fg-muted);
      font-size: var(--step--1);
    }
    .count {
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
    }
    @media (max-width: 40rem) {
      .row {
        grid-template-columns: 1fr auto;
        gap: 0.25rem 1rem;
      }
      .note {
        grid-column: 1 / -1;
      }
    }
  </style>
</Base>
