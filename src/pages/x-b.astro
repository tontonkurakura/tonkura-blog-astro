---
import Base from "../layouts/Base.astro";
import { getCounts, getRecent, formatDate } from "../lib/home";

const c = await getCounts();
const recent = await getRecent(8);

const sections = [
  { href: "/wiki", title: "Wiki", count: c.wiki },
  { href: "/database", title: "Database", count: c.database },
  { href: "/neurology", title: "Notes", count: c.neurology },
  { href: "/blog", title: "Blog", count: c.blog },
  { href: "/imaging", title: "Imaging", count: c.imaging },
  { href: "/anatomical-atlas", title: "Atlas", count: null },
  { href: "/tools", title: "Tools", count: 4 },
  { href: "/gallery", title: "Gallery", count: 62 },
];
---

<Base title="TonKurA" wide>
  <section class="hero">
    <h1>TonKurA</h1>
    <p class="lead">
      神経内科と神経画像のノート。臨床で引っかかったことを調べ、書き留めている。
    </p>
  </section>

  <nav class="chips">
    {
      sections.map((s) => (
        <a class="chip" href={s.href}>
          {s.title}
          {s.count != null && s.count > 0 && <span class="n">{s.count}</span>}
        </a>
      ))
    }
  </nav>

  <section class="recent">
    <h2>最近手を入れたもの</h2>
    <ul>
      {
        recent.map((r) => (
          <li>
            <a href={r.href}>
              <time>{formatDate(r.date)}</time>
              <span class="t">{r.title}</span>
              <span class="s">{r.section}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .hero {
      padding: 3.5rem 0 1.75rem;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 7vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 1;
      margin: 0 0 0.9rem;
    }
    .lead {
      color: var(--fg-muted);
      font-size: var(--step-0);
      line-height: 1.7;
      margin: 0;
      max-width: 34rem;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0 0 2.5rem;
    }
    .chip {
      align-items: baseline;
      border: 1px solid var(--border);
      border-radius: 999px;
      display: inline-flex;
      gap: 0.4rem;
      font-size: var(--step--1);
      padding: 0.4rem 0.9rem;
      transition:
        background 0.15s ease,
        border-color 0.15s ease;
    }
    .chip:hover {
      background: var(--bg-subtle);
      border-color: var(--fg-muted);
    }
    .chip .n {
      color: var(--fg-muted);
      font-variant-numeric: tabular-nums;
    }

    .recent h2 {
      border-bottom: 1px solid var(--border);
      font-size: var(--step--1);
      font-weight: 600;
      letter-spacing: 0.08em;
      margin: 0 0 0.5rem;
      padding-bottom: 0.75rem;
      text-transform: uppercase;
    }
    .recent ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .recent li a {
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      display: grid;
      gap: 1rem;
      grid-template-columns: 6rem 1fr auto;
      margin-inline: -0.75rem;
      padding: 0.9rem 0.75rem;
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .recent li a:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .recent time {
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
    }
    .recent .t {
      font-size: var(--step-0);
      line-height: 1.5;
    }
    .recent .s {
      color: var(--fg-muted);
      font-size: var(--step--1);
    }
    @media (max-width: 40rem) {
      .recent li a {
        grid-template-columns: 1fr auto;
      }
      .recent time {
        grid-column: 1 / -1;
      }
    }
  </style>
</Base>
