---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import NeuroTree from "../../components/NeuroTree.astro";
import { buildNeurologyTree } from "../../lib/neurology";
import { getCollection } from "astro:content";

const tree = await buildNeurologyTree();
const total = (await getCollection("neurology")).length;
---

<Base title="神経内科ノート | TonKurA" wide>
  <PageHeader title="神経内科ノート" meta={`${total} 本`} />

  <div class="sections">
    {
      tree.map((section) => (
        <section>
          <h2>{section.label ?? section.name}</h2>
          <NeuroTree nodes={section.children} />
        </section>
      ))
    }
  </div>

  <style>
    .sections {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
      gap: 2rem 2.5rem;
      align-items: start;
    }
    h2 {
      font-size: var(--step-1);
      letter-spacing: -0.01em;
      margin: 0 0 0.75rem;
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--border);
    }
  </style>
</Base>
