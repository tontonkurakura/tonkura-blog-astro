---
import Base from "../layouts/Base.astro";

const places = [
  { href: "/notes", label: "Notes", note: "問い・覚え書き・考察・方法論" },
  { href: "/database", label: "Database", note: "高次脳機能症候の事典" },
  { href: "/anatomical-atlas", label: "Atlas", note: "脳を 3D で見る" },
  { href: "/tools", label: "Tools", note: "臨床スコアの計算機" },
  { href: "/gallery", label: "Gallery", note: "写真" },
];
---

<Base title="404 | TonKurA" description="お探しのページは見つかりませんでした。">
  <section class="lost">
    <p class="code">404</p>
    <h1>このページはありません</h1>
    <p class="lead">
      移転したか、URL が変わったか、もともと無かったかのいずれかである。
    </p>

    <ul class="places">
      {
        places.map((p) => (
          <li>
            <a href={p.href}>{p.label}</a>
            <span>{p.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .lost {
      padding: 3rem 0 4rem;
    }
    .code {
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.2em;
      margin: 0 0 1rem;
    }
    h1 {
      font-size: var(--step-2);
      letter-spacing: -0.02em;
      line-height: 1.3;
      margin: 0 0 0.75rem;
    }
    .lead {
      color: var(--fg-muted);
      margin: 0 0 3rem;
    }
    .places {
      border-top: 1px solid var(--border);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .places li {
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
      padding: 0.9rem 0;
    }
    .places a {
      font-size: var(--step-1);
      font-weight: 600;
      letter-spacing: -0.02em;
      min-width: 7rem;
    }
    .places a:hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
    .places span {
      color: var(--fg-muted);
      font-size: var(--step--1);
    }
  </style>
</Base>
