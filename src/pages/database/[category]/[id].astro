---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { categories } from "../../../data/higherBrainFunction";
import "../../../styles/prose.css";

export async function getStaticPaths() {
  const all = await getCollection("database");
  return all.map((entry) => {
    const [category, id] = entry.id.split("/");
    return { params: { category, id }, props: { entry, category, id } };
  });
}

const { entry, category, id } = Astro.props;
const { Content } = await render(entry);

const cat = categories.find((c) => c.id === category);
const item = cat?.items.find((i) => i.id === id);
---

<Base title={`${item?.title ?? id} | 高次脳機能データベース`}>
  <nav class="crumb">
    <a href="/database">高次脳機能データベース</a>
    {cat && <span>/ {cat.title}</span>}
  </nav>

  <article class="prose db-body">
    <Content />
  </article>

  <style>
    .crumb {
      font-size: var(--step--1);
      color: var(--fg-muted);
      margin-bottom: 1rem;
    }
    .crumb a {
      color: var(--fg-muted);
    }
    .db-body :global(h1) {
      font-size: 1.75rem;
      line-height: 1.3;
      margin: 0 0 1.5rem;
    }
  </style>
</Base>
