---
import Base from "../layouts/Base.astro";

/* 3D ビューアは別プロジェクト (~/dev/neuroatlas) で作り、生成物だけを
   public/brain-viewer/ に置いている。ビューアは自己完結した HTML なので
   iframe で埋める。Astro のビルドは中身に関与しない（静的ファイルとして配信）。

   **このページは見出しも説明も置かない。**ビューアの中に一覧・操作子・
   ライセンスのモーダルが全部入っているので、外に同じことを書くと二重になる。
   画面はビューアに使い切る。

   loading は eager にしてある。iframe だけのページなので、遅らせても
   読者が待つ場所が変わるだけで、送る量は変わらない。 */
const viewer = "/brain-viewer/viewer.html";
---

<Base
  title="Atlas | TonKurA"
  description="MNI 標準脳を 5 つのアトラス（解剖・血管支配・機能・トラクトグラフィー）で見る 3D モデル。断面で切ると切り口に MRI が出る。"
  bare
>
  <div class="viewer-full">
    <iframe src={viewer} title="3D 脳アトラスビューア" allow="fullscreen"></iframe>
  </div>
</Base>

<style is:global>
  /* ヘッダー・本文・フッターを縦に積んで、本文に余りを全部渡す。
     高さを calc で決め打ちにすると、ヘッダーの行数が変わったときに崩れる。 */
  body:has(.viewer-full) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  body:has(.viewer-full) main {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  /* フッターは出さない。1 行のためにビューアを削る理由がない */
  body:has(.viewer-full) .site-footer {
    display: none;
  }
</style>

<style>
  .viewer-full {
    flex: 1;
    min-height: 0;
    background: #0a0d14;
  }
  .viewer-full iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
