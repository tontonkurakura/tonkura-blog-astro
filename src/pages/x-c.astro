---
import Base from "../layouts/Base.astro";
import { getCounts, getRecent, formatDate } from "../lib/home";

const c = await getCounts();
const recent = await getRecent(6);

const sections = [
  { href: "/wiki", title: "Wiki", note: "勉強会で出た問い", count: c.wiki },
  { href: "/database", title: "Database", note: "高次脳機能症候の事典", count: c.database },
  { href: "/neurology", title: "Notes", note: "神経内科の覚え書き", count: c.neurology },
  { href: "/blog", title: "Blog", note: "考えたことを長めに", count: c.blog },
  { href: "/imaging", title: "Imaging", note: "神経画像解析の方法論", count: c.imaging },
  { href: "/anatomical-atlas", title: "Atlas", note: "脳を 3D で見る", count: null },
  { href: "/tools", title: "Tools", note: "臨床スコアの計算機", count: 4 },
  { href: "/gallery", title: "Gallery", note: "写真", count: 62 },
];
---

<Base title="TonKurA" wide>
  <section class="hero">
    <h1>TonKurA</h1>
    <p class="lead">
      神経内科と神経画像のノート。臨床で引っかかったことを調べ、書き留めている。
    </p>
  </section>

  <div class="cols">
    <nav class="index">
      {
        sections.map((s) => (
          <a class="row" href={s.href}>
            <span class="name">{s.title}</span>
            <span class="note">{s.note}</span>
            {s.count != null && s.count > 0 && (
              <span class="count">{s.count}</span>
            )}
          </a>
        ))
      }
    </nav>

    <aside class="recent">
      <h2>最近手を入れたもの</h2>
      <ul>
        {
          recent.map((r) => (
            <li>
              <a href={r.href}>
                <span class="t">{r.title}</span>
                <span class="meta">
                  <time>{formatDate(r.date)}</time>
                  <span class="s">{r.section}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

  <style>
    .hero {
      padding: 3.5rem 0 2rem;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 7vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 1;
      margin: 0 0 0.9rem;
    }
    .lead {
      color: var(--fg-muted);
      font-size: var(--step-0);
      line-height: 1.7;
      margin: 0;
      max-width: 34rem;
    }

    .cols {
      display: grid;
      gap: 3rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 60rem) {
      .cols {
        grid-template-columns: 1.6fr 1fr;
        gap: 4rem;
      }
    }

    .index {
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
    }
    .row {
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      display: grid;
      gap: 0.15rem 1rem;
      grid-template-columns: 1fr auto;
      margin-inline: -0.75rem;
      padding: 1rem 0.75rem;
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .row:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .name {
      font-size: var(--step-1);
      font-weight: 550;
      letter-spacing: -0.02em;
    }
    .note {
      color: var(--fg-muted);
      font-size: var(--step--1);
      grid-column: 1;
    }
    .count {
      color: var(--fg-muted);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      grid-row: 1;
      grid-column: 2;
    }

    .recent h2 {
      border-bottom: 1px solid var(--border);
      font-size: var(--step--1);
      font-weight: 600;
      letter-spacing: 0.08em;
      margin: 0 0 0.25rem;
      padding-bottom: 0.75rem;
      text-transform: uppercase;
    }
    .recent ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .recent li a {
      display: block;
      margin-inline: -0.75rem;
      padding: 0.8rem 0.75rem;
      transition:
        background 0.18s ease,
        padding-left 0.18s ease;
    }
    .recent li a:hover {
      background: var(--bg-subtle);
      padding-left: 1.25rem;
    }
    .recent .t {
      display: block;
      font-size: var(--step--1);
      line-height: 1.5;
    }
    .recent .meta {
      color: var(--fg-muted);
      display: flex;
      font-size: var(--step--1);
      gap: 0.75rem;
      margin-top: 0.2rem;
    }
    .recent time {
      font-variant-numeric: tabular-nums;
    }
  </style>
</Base>
