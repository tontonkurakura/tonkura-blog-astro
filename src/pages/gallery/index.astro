---
import Base from "../../layouts/Base.astro";
import PinIcon from "../../components/PinIcon.astro";
import { getGalleryPhotos } from "../../lib/photos";

const photos = await getGalleryPhotos();

/** 旧サイトと同じ1枚を扉にする。無ければ先頭。 */
const HERO = "DSC02359-Enhanced-NR-Pano-Edit.jpg";
const hero = photos.find((p) => p.name === HERO) ?? photos[0];
const rest = photos.filter((p) => p !== hero);

/** 黄金比を基準にした高さ。旧サイトの PHOTO_HEIGHTS と同じ値。 */
const HEIGHT = { portrait: 600, landscape: 371, square: 500 } as const;

/** 3列に順繰りで配る。列ごとに高さが揃わないので段差が出る。 */
const columns: (typeof rest)[] = [[], [], []];
rest.forEach((p, i) => columns[i % 3].push(p));

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<Base title="Gallery | TonKurA" bare forceDark revealHeaderOnScroll>
  <section class="hero">
    <img src={hero.full} alt={hero.description} fetchpriority="high" />
    <div class="veil"></div>
    <div class="titles">
      <h1>Ephemera</h1>
      <p>- Fragments of Consciousness -</p>
      <svg
        class="arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
      </svg>
    </div>
    {
      hero.description && (
        <p class="place">
          <PinIcon />
          {hero.description}
        </p>
      )
    }
  </section>

  <div class="grid">
    {
      columns.map((column) => (
        <div class="column">
          {column.map((p) => (
            <button
              type="button"
              class="shot"
              style={`height:${HEIGHT[p.orientation]}px`}
              data-full={p.full}
              data-w={p.width}
              data-h={p.height}
              data-place={p.description}
              data-date={p.date ? formatDate(p.date) : ""}
              data-camera={p.camera ?? ""}
              data-lens={p.lens ?? ""}
              data-focal={p.focalLength ?? ""}
              data-aperture={p.aperture ?? ""}
              data-shutter={p.shutterSpeed ?? ""}
              data-iso={p.iso ?? ""}
              aria-label={`写真: ${p.description || "無題"}`}
            >
              <img src={p.thumb} alt={p.description} loading="lazy" />
              {
                p.description && (
                  <span class="place">
                    <PinIcon />
                    {p.description}
                  </span>
                )
              }
            </button>
          ))}
        </div>
      ))
    }
  </div>

  <dialog id="lightbox" aria-label="写真の拡大">
    <button type="button" class="close" aria-label="閉じる">×</button>
    <div class="frame">
      <img alt="" />
      <dl class="info">
        <div class="row is-lead" data-field="place"><dd></dd></div>
        <div class="row" data-field="date"><dt>Date</dt><dd></dd></div>
        <div class="row" data-field="camera"><dt>Camera</dt><dd></dd></div>
        <div class="row" data-field="lens"><dt>Lens</dt><dd></dd></div>
        <div class="row" data-field="focal"><dt>Focal length</dt><dd></dd></div>
        <div class="row" data-field="aperture"><dt>Aperture</dt><dd></dd></div>
        <div class="row" data-field="shutter"><dt>Shutter speed</dt><dd></dd></div>
        <div class="row" data-field="iso"><dt>ISO</dt><dd></dd></div>
      </dl>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      const box = document.getElementById("lightbox");
      if (!box) return;
      const frame = box.querySelector(".frame");
      const img = box.querySelector(".frame img");
      const info = box.querySelector(".info");
      const rows = box.querySelectorAll(".info .row");
      const EASE = "linear";
      const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      let origin = null;

      /* 表示サイズを縦横比から先に決めて px で固定する。
         決めないと「いま読んでいる画像の実寸」で決まり、サムネイルから
         拡大用に差し替わった瞬間に寸法が変わって跳ねる。 */
      function sizeImage(b) {
        const w = Number(b.dataset.w);
        const h = Number(b.dataset.h);
        if (!w || !h) return;
        const narrow = matchMedia("(max-width: 48rem)").matches;
        let maxW, maxH;
        if (narrow) {
          maxW = innerWidth * 0.92;
          maxH = innerHeight * 0.62;
        } else {
          const gap = parseFloat(getComputedStyle(frame).columnGap) || 24;
          maxW = Math.min(
            innerWidth * 0.94 - info.getBoundingClientRect().width - gap,
            1400,
          );
          maxH = innerHeight * 0.85;
        }
        const scale = Math.min(maxW / w, maxH / h);
        img.style.width = Math.round(w * scale) + "px";
        img.style.height = Math.round(h * scale) + "px";
      }

      function fill(b) {
        rows.forEach(function (row) {
          const v = b.dataset[row.dataset.field] || "";
          row.querySelector("dd").textContent = v;
          row.hidden = !v;
        });
      }

      /* 押した写真の位置から拡大先へ動かす。先に縮小版を出しておき、
         大きいほうは読めた時点で差し替える。待ち時間が見えない。 */
      function open(b) {
        origin = b;
        const thumb = b.querySelector("img");
        fill(b);
        img.src = thumb.currentSrc || thumb.src;
        box.showModal();
        sizeImage(b);

        const from = thumb.getBoundingClientRect();
        const to = img.getBoundingClientRect();
        if (motion && to.width > 0) {
          img.animate(
            [
              {
                transformOrigin: "center",
                transform:
                  "translate(" +
                  (from.left + from.width / 2 - (to.left + to.width / 2)) +
                  "px," +
                  (from.top + from.height / 2 - (to.top + to.height / 2)) +
                  "px) scale(" +
                  from.width / to.width +
                  "," +
                  from.height / to.height +
                  ")",
              },
              { transform: "none" },
            ],
            { duration: 120, easing: EASE },
          );
          info.animate(
            [
              { opacity: 0, transform: "translateX(0.75rem)" },
              { opacity: 1, transform: "none" },
            ],
            { duration: 120, delay: 50, easing: EASE, fill: "backwards" },
          );
        }

        const full = new Image();
        full.onload = function () {
          if (box.open) img.src = full.src;
        };
        full.src = b.dataset.full;
      }

      /* 閉じ。来た道を戻さず、その場でわずかに縮んで消える。
         終わりに向けて加速させる（ease-in）と、引き止められずに離れる感じになる。 */
      function close() {
        if (!box.open) return;
        if (!motion) {
          box.close();
          return;
        }
        box.classList.add("is-closing");
        const out = { duration: 100, easing: "ease-in", fill: "forwards" };
        const a = img.animate(
          [
            { opacity: 1, transform: "none" },
            { opacity: 0, transform: "scale(0.96)" },
          ],
          out,
        );
        const i = info.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 80,
          easing: "ease-in",
          fill: "forwards",
        });
        a.finished.then(function () {
          a.cancel();
          i.cancel();
          box.classList.remove("is-closing");
          box.close();
        });
      }

      document.querySelectorAll(".shot").forEach(function (b) {
        b.addEventListener("click", function () {
          open(b);
        });
      });
      box.querySelector(".close").addEventListener("click", close);
      box.addEventListener("click", function (e) {
        if (!frame.contains(e.target) && e.target !== box.querySelector(".close")) close();
      });
      addEventListener("resize", function () {
        if (box.open && origin) sizeImage(origin);
      });
      /* ESC の既定は即座に閉じるので、横取りして同じ閉じ方に寄せる。 */
      box.addEventListener("cancel", function (e) {
        e.preventDefault();
        close();
      });
      box.addEventListener("close", function () {
        img.removeAttribute("src");
        img.style.width = "";
        img.style.height = "";
      });
    })();
  </script>

  <style is:global>
    /* 写真のページだけ地を純黒にする。トークンの暗い配色（#111110）より沈む。 */
    :root[data-theme="dark"] {
      --bg: #000;
      --bg-subtle: #0a0a0a;
      --surface: #0b0b0b;
    }
  </style>

  <style>
    /* 扉。画面いっぱいの1枚に題を重ねる。 */
    .hero {
      height: 100vh;
      position: relative;
      overflow: hidden;
    }
    .hero > img {
      height: 100%;
      object-fit: cover;
      object-position: top;
      width: 100%;
    }
    .veil {
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.45),
        transparent 45%,
        rgba(0, 0, 0, 0.35)
      );
      inset: 0;
      position: absolute;
    }
    .titles {
      align-items: center;
      display: flex;
      flex-direction: column;
      inset: 0;
      justify-content: center;
      position: absolute;
      text-align: center;
    }
    .titles h1 {
      color: #fff;
      font-size: clamp(3rem, 11vw, 7rem);
      font-weight: 700;
      letter-spacing: 0.06em;
      margin: 0;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
      animation: rise 1s ease 0.3s both;
    }
    .titles p {
      color: rgba(255, 255, 255, 0.9);
      font-size: clamp(0.95rem, 2.2vw, 1.5rem);
      font-weight: 300;
      letter-spacing: 0.28em;
      margin: 2.5rem 0 0;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
      animation: rise 1s ease 0.8s both;
    }
    .arrow {
      color: rgba(255, 255, 255, 0.7);
      height: 2rem;
      margin-top: 5rem;
      width: 2rem;
      animation:
        rise 1s ease 1.3s both,
        bob 2s ease-in-out 2.3s infinite;
    }
    .hero .place {
      align-items: center;
      gap: 0.5rem;
      backdrop-filter: blur(6px);
      background: rgba(0, 0, 0, 0.3);
      border-radius: 999px;
      bottom: 2rem;
      color: rgba(255, 255, 255, 0.85);
      display: flex;
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      margin: 0;
      padding: 0.5rem 1rem;
      position: absolute;
      right: 2rem;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes bob {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(0.5rem);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .titles h1,
      .titles p,
      .arrow {
        animation: none;
        opacity: 1;
      }
    }

    /* 並び。3列に順繰りで配り、高さは向きで決める。 */
    .grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;
      margin: 0 auto;
      max-width: 1800px;
      padding: 2rem;
    }
    @media (min-width: 48rem) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .shot {
      background: none;
      border: 0;
      border-radius: 12px;
      box-shadow:
        0 12px 40px rgba(255, 255, 255, 0.08),
        0 4px 12px rgba(255, 255, 255, 0.04);
      cursor: pointer;
      display: block;
      overflow: hidden;
      padding: 0;
      position: relative;
      width: 100%;
    }
    .shot::after {
      border-radius: 12px;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
      transition: box-shadow 0.5s ease;
      z-index: 2;
    }
    .shot:hover::after,
    .shot:focus-visible::after {
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    }
    .shot img {
      display: block;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s ease;
      width: 100%;
    }
    .shot:hover img,
    .shot:focus-visible img {
      transform: scale(1.05);
      /* 動かす直前だけ層を分ける。61枚すべてに常時付けるとメモリを食う。 */
      will-change: transform;
    }
    .shot .place {
      align-items: center;
      backdrop-filter: blur(6px);
      display: flex;
      gap: 0.4rem;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 999px;
      bottom: 1rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.75rem;
      left: 1rem;
      letter-spacing: 0.06em;
      opacity: 0;
      padding: 0.35rem 0.8rem;
      position: absolute;
      transform: translateY(0.75rem);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
      z-index: 3;
    }
    .shot:hover .place,
    .shot:focus-visible .place {
      opacity: 1;
      transform: none;
    }

    /* 拡大。dialog の既定の枠は消す。 */
    #lightbox {
      background: transparent;
      border: 0;
      height: 100%;
      max-height: 100%;
      max-width: 100%;
      overflow: hidden;
      padding: 0;
      width: 100%;
    }
    #lightbox[open] {
      align-items: center;
      display: flex;
      justify-content: center;
    }
    #lightbox::backdrop {
      animation: veil 0.1s linear both;
      background: rgba(0, 0, 0, 0.96);
    }
    #lightbox.is-closing::backdrop {
      animation: veil 0.11s linear reverse both;
    }
    @keyframes veil {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .frame {
      align-items: center;
      display: flex;
      gap: clamp(1.5rem, 4vw, 3rem);
      max-height: 90vh;
      max-width: 94vw;
    }
    /* 寸法は開くときに px で入れる。ここの上限は JS が効かないときの保険。 */
    .frame img {
      display: block;
      max-height: 85vh;
      max-width: min(70vw, 1400px);
      object-fit: contain;
    }

    /* 撮影情報。記号は付けず、左揃えで縦に並べる。 */
    .info {
      color: rgba(255, 255, 255, 0.55);
      display: flex;
      flex-direction: column;
      font-size: 0.8rem;
      gap: 0.9rem;
      letter-spacing: 0.03em;
      margin: 0;
      max-height: 85vh;
      overflow-y: auto;
      text-align: left;
      width: clamp(9rem, 18vw, 13rem);
    }
    .info .row[hidden] {
      display: none;
    }
    .info .is-lead dd {
      color: rgba(255, 255, 255, 0.95);
      font-size: 0.95rem;
      margin: 0;
    }
    .info dt {
      color: rgba(255, 255, 255, 0.35);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .info dd {
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.5;
      margin: 0.2rem 0 0;
    }

    @media (max-width: 48rem) {
      .frame {
        flex-direction: column;
        gap: 1rem;
      }
      .frame img {
        max-height: 62vh;
        max-width: 92vw;
      }
      .info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem 1.5rem;
        max-height: none;
        width: 92vw;
      }
    }

    #lightbox .close {
      background: rgba(255, 255, 255, 0.08);
      border: 0;
      border-radius: 999px;
      color: #fff;
      cursor: pointer;
      font-size: 1.4rem;
      height: 2.75rem;
      line-height: 1;
      position: fixed;
      right: 1.5rem;
      top: 1.5rem;
      transition: background 0.2s ease;
      width: 2.75rem;
      z-index: 2;
    }
    #lightbox .close:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  </style>
</Base>
