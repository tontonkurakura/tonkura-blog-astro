---
import Base from "../../layouts/Base.astro";
import PinIcon from "../../components/PinIcon.astro";
import { getGalleryPhotos } from "../../lib/photos";

const photos = await getGalleryPhotos();

/** 旧サイトと同じ1枚を扉にする。無ければ先頭。 */
const HERO = "DSC02359-Enhanced-NR-Pano-Edit.jpg";
const hero = photos.find((p) => p.name === HERO) ?? photos[0];
const rest = photos.filter((p) => p !== hero);

/** 黄金比を基準にした高さ。旧サイトの PHOTO_HEIGHTS と同じ値。 */
const HEIGHT = { portrait: 600, landscape: 371, square: 500 } as const;

/** 3列に順繰りで配る。列ごとに高さが揃わないので段差が出る。 */
const columns: (typeof rest)[] = [[], [], []];
rest.forEach((p, i) => columns[i % 3].push(p));

const exifOf = (p: (typeof photos)[number]) =>
  [p.camera, p.lens, p.focalLength, p.aperture, p.shutterSpeed, p.iso].filter(
    Boolean,
  );
---

<Base title="Gallery | TonKurA" bare forceDark revealHeaderOnScroll>
  <section class="hero">
    <img src={hero.src} alt={hero.description} fetchpriority="high" />
    <div class="veil"></div>
    <div class="titles">
      <h1>Ephemera</h1>
      <p>- Fragments of Consciousness -</p>
      <svg
        class="arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
      </svg>
    </div>
    {
      hero.description && (
        <p class="place">
          <PinIcon />
          {hero.description}
        </p>
      )
    }
  </section>

  <div class="grid">
    {
      columns.map((column) => (
        <div class="column">
          {column.map((p) => (
            <button
              type="button"
              class="shot"
              style={`height:${HEIGHT[p.orientation]}px`}
              data-src={p.src}
              data-place={p.description}
              data-exif={exifOf(p).join(" · ")}
              aria-label={`写真: ${p.description || "無題"}`}
            >
              <img src={p.src} alt={p.description} loading="lazy" />
              {
                p.description && (
                  <span class="place">
                    <PinIcon />
                    {p.description}
                  </span>
                )
              }
            </button>
          ))}
        </div>
      ))
    }
  </div>

  <dialog id="lightbox" aria-label="写真の拡大">
    <button type="button" class="close" aria-label="閉じる">×</button>
    <img alt="" />
    <p class="meta"><span class="lb-place"></span><span class="lb-exif"></span></p>
  </dialog>

  <script is:inline>
    (function () {
      const box = document.getElementById("lightbox");
      if (!box) return;
      const img = box.querySelector("img");
      const place = box.querySelector(".lb-place");
      const exif = box.querySelector(".lb-exif");

      document.querySelectorAll(".shot").forEach(function (b) {
        b.addEventListener("click", function () {
          img.src = b.dataset.src;
          img.alt = b.dataset.place || "";
          place.textContent = b.dataset.place || "";
          exif.textContent = b.dataset.exif || "";
          box.showModal();
        });
      });

      function close() {
        if (box.open) box.close();
      }
      box.querySelector(".close").addEventListener("click", close);
      // 画像の外を押したら閉じる
      box.addEventListener("click", function (e) {
        if (e.target === box) close();
      });
      box.addEventListener("close", function () {
        img.removeAttribute("src");
      });
    })();
  </script>

  <style is:global>
    /* 写真のページだけ地を純黒にする。トークンの暗い配色（#111110）より沈む。 */
    :root[data-theme="dark"] {
      --bg: #000;
      --bg-subtle: #0a0a0a;
      --surface: #0b0b0b;
    }
  </style>

  <style>
    /* 扉。画面いっぱいの1枚に題を重ねる。 */
    .hero {
      height: 100vh;
      position: relative;
      overflow: hidden;
    }
    .hero > img {
      height: 100%;
      object-fit: cover;
      object-position: top;
      width: 100%;
    }
    .veil {
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.45),
        transparent 45%,
        rgba(0, 0, 0, 0.35)
      );
      inset: 0;
      position: absolute;
    }
    .titles {
      align-items: center;
      display: flex;
      flex-direction: column;
      inset: 0;
      justify-content: center;
      position: absolute;
      text-align: center;
    }
    .titles h1 {
      color: #fff;
      font-size: clamp(3rem, 11vw, 7rem);
      font-weight: 700;
      letter-spacing: 0.06em;
      margin: 0;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
      animation: rise 1s ease 0.3s both;
    }
    .titles p {
      color: rgba(255, 255, 255, 0.9);
      font-size: clamp(0.95rem, 2.2vw, 1.5rem);
      font-weight: 300;
      letter-spacing: 0.28em;
      margin: 2.5rem 0 0;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
      animation: rise 1s ease 0.8s both;
    }
    .arrow {
      color: rgba(255, 255, 255, 0.7);
      height: 2rem;
      margin-top: 5rem;
      width: 2rem;
      animation:
        rise 1s ease 1.3s both,
        bob 2s ease-in-out 2.3s infinite;
    }
    .hero .place {
      align-items: center;
      gap: 0.5rem;
      backdrop-filter: blur(6px);
      background: rgba(0, 0, 0, 0.3);
      border-radius: 999px;
      bottom: 2rem;
      color: rgba(255, 255, 255, 0.85);
      display: flex;
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      margin: 0;
      padding: 0.5rem 1rem;
      position: absolute;
      right: 2rem;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes bob {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(0.5rem);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .titles h1,
      .titles p,
      .arrow {
        animation: none;
        opacity: 1;
      }
    }

    /* 並び。3列に順繰りで配り、高さは向きで決める。 */
    .grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;
      margin: 0 auto;
      max-width: 1800px;
      padding: 2rem;
    }
    @media (min-width: 48rem) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .shot {
      background: none;
      border: 0;
      border-radius: 12px;
      box-shadow:
        0 12px 40px rgba(255, 255, 255, 0.08),
        0 4px 12px rgba(255, 255, 255, 0.04);
      cursor: pointer;
      display: block;
      overflow: hidden;
      padding: 0;
      position: relative;
      width: 100%;
    }
    .shot::after {
      border-radius: 12px;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
      transition: box-shadow 0.5s ease;
      z-index: 2;
    }
    .shot:hover::after,
    .shot:focus-visible::after {
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    }
    .shot img {
      display: block;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s ease;
      width: 100%;
    }
    .shot:hover img,
    .shot:focus-visible img {
      transform: scale(1.05);
    }
    .shot .place {
      align-items: center;
      backdrop-filter: blur(6px);
      display: flex;
      gap: 0.4rem;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 999px;
      bottom: 1rem;
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.75rem;
      left: 1rem;
      letter-spacing: 0.06em;
      opacity: 0;
      padding: 0.35rem 0.8rem;
      position: absolute;
      transform: translateY(0.75rem);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
      z-index: 3;
    }
    .shot:hover .place,
    .shot:focus-visible .place {
      opacity: 1;
      transform: none;
    }

    /* 拡大。dialog の既定の枠は消す。 */
    #lightbox {
      background: rgba(0, 0, 0, 0.92);
      border: 0;
      height: 100%;
      max-height: 100%;
      max-width: 100%;
      padding: 0;
      width: 100%;
    }
    #lightbox::backdrop {
      background: rgba(0, 0, 0, 0.92);
    }
    #lightbox img {
      display: block;
      inset: 0;
      margin: auto;
      max-height: 85vh;
      max-width: 92vw;
      object-fit: contain;
      position: absolute;
    }
    #lightbox .meta {
      bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.75);
      display: flex;
      flex-wrap: wrap;
      font-size: 0.8rem;
      gap: 0.5rem 1.5rem;
      justify-content: center;
      left: 0;
      letter-spacing: 0.04em;
      margin: 0;
      padding: 0 1.5rem;
      position: absolute;
      right: 0;
      text-align: center;
    }
    #lightbox .lb-exif {
      color: rgba(255, 255, 255, 0.5);
    }
    #lightbox .close {
      background: rgba(0, 0, 0, 0.5);
      border: 0;
      border-radius: 999px;
      color: #fff;
      cursor: pointer;
      font-size: 1.5rem;
      height: 2.75rem;
      line-height: 1;
      position: absolute;
      right: 1.5rem;
      top: 1.5rem;
      width: 2.75rem;
      z-index: 2;
    }
    #lightbox .close:hover {
      background: rgba(0, 0, 0, 0.75);
    }
  </style>
</Base>
