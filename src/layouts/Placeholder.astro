---
import Base from "./Base.astro";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Base title={`${title} | TonKurA`}>
  <div class="ph">
    <h1>{title}</h1>
    <p>
      このページは 3D ビューアの作り直しに伴い、別プロジェクトとして準備中です。
    </p>
    <a href="/">← Home</a>
  </div>

  <style>
    .ph {
      min-height: 40vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.75rem;
    }
    h1 {
      font-size: var(--step-2);
      letter-spacing: -0.02em;
      margin: 0;
    }
    p {
      color: var(--fg-muted);
      margin: 0;
      max-width: var(--measure);
    }
    a {
      color: var(--fg-muted);
      font-size: var(--step--1);
      margin-top: 1rem;
    }
  </style>
</Base>
