---
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
  /** 読み幅を広い一覧レイアウトにするか */
  wide?: boolean;
  /** 最上部ではヘッダーを出さず、下に降りたところで現す（トップページ用） */
  revealHeaderOnScroll?: boolean;
  /** 本文の枠と余白を外し、ページ側にレイアウトを任せる（全面表示用） */
  bare?: boolean;
  /** 読者の設定に関わらず暗い配色で出す（写真を見せるページ用） */
  forceDark?: boolean;
}
const {
  title,
  description,
  wide = false,
  revealHeaderOnScroll = false,
  bare = false,
  forceDark = false,
} = Astro.props;

// 文章4種は入口を Writing にまとめてある（DECISIONS.md）。
// コレクションは分けたままなので、現在地の判定だけ4つを束ねる。
const nav = [
  { href: "/", label: "Home", also: [] as string[] },
  {
    href: "/writing",
    label: "Writing",
    also: ["/wiki", "/neurology", "/blog", "/imaging"],
  },
  { href: "/database", label: "Database", also: [] },
  { href: "/anatomical-atlas", label: "Atlas", also: [] },
  { href: "/tools", label: "Tools", also: [] },
  { href: "/gallery", label: "Gallery", also: [] },
];
const path = Astro.url.pathname;
const isActive = (item: { href: string; also: string[] }) =>
  item.href === "/"
    ? path === "/"
    : [item.href, ...item.also].some((p) => path.startsWith(p));
---

<!doctype html>
<html lang="ja" data-theme={forceDark ? "dark" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* 「まだ見つかってほしくない」方針に合わせ、当面は検索除外で立てる */}
    <meta name="robots" content="noindex, nofollow" />
    {/* テーマのちらつき防止（描画前に data-theme を確定させる）。
        暗さを固定したページでは読者の設定を当てない。 */}
    <script is:inline>
      (function () {
        if (document.documentElement.dataset.theme) return;
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body>
    <header class:list={["site-header", { reveal: revealHeaderOnScroll }]}>
      <div class="bar">
        <a class="brand" href="/">TonKurA</a>
        <nav>
          {
            nav
              .slice(1)
              .map((item) => (
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive(item) }]}
                >
                  {item.label}
                </a>
              ))
          }
        </nav>
        {!forceDark && <ThemeToggle />}
      </div>
    </header>

    {revealHeaderOnScroll && <div class="header-sentinel" aria-hidden="true" />}

    {/* reveal が付いているページ（トップ）だけ、下に降りたところでヘッダーを現す。
        スクロールイベントではなく交差監視にしてある。上下どちらの向きでも同じ判定になり、
        戻ったときに隠れ直さない、という取りこぼしが起きない。 */}
    <script is:inline>
      (function () {
        const header = document.querySelector(".site-header.reveal");
        const sentinel = document.querySelector(".header-sentinel");
        if (!header || !sentinel) return;
        new IntersectionObserver(function (entries) {
          header.classList.toggle("is-visible", !entries[0].isIntersecting);
        }).observe(sentinel);
      })();
    </script>

    <main class:list={[{ container: !bare, wide: !bare && wide }]}>
      <slot />
    </main>


    <footer class="site-footer">
      <div class="container wide">
        <a class="foot-brand" href="/">TonKurA</a>
      </div>
    </footer>

    <style>
      /* 交差監視の目印。ここが画面から外れたらヘッダーを現す。流れには影響させない。 */
      .header-sentinel {
        height: 160px;
        left: 0;
        pointer-events: none;
        position: absolute;
        top: 0;
        width: 1px;
      }

      /* トップページ用。最上部では画面の外に置き、流れからも外して余白を残さない。 */
      .site-header.reveal {
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        transform: translateY(-100%);
        visibility: hidden;
        transition:
          transform 0.28s ease,
          visibility 0.28s;
      }
      .site-header.reveal.is-visible {
        transform: none;
        visibility: visible;
      }
      @media (prefers-reduced-motion: reduce) {
        .site-header.reveal {
          transition: none;
        }
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(8px);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      body {
        position: relative;
      }
      .bar {
        max-width: var(--measure-wide);
        margin: 0 auto;
        padding: 0.7rem var(--pad-x);
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--fg);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      nav {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
      }
      .nav-link {
        color: var(--fg-muted);
        text-decoration: none;
        font-size: var(--step--1);
        font-weight: 500;
        padding: 0.3rem 0.6rem;
        border-radius: 7px;
      }
      .nav-link:hover {
        color: var(--fg);
        background: var(--bg-subtle);
      }
      .nav-link.active {
        color: var(--fg);
        background: var(--bg-subtle);
      }
      .container {
        max-width: calc(var(--measure) + var(--pad-x) * 2);
        margin: 0 auto;
        padding: 3rem var(--pad-x) 5rem;
      }
      .container.wide {
        max-width: calc(var(--measure-wide) + var(--pad-x) * 2);
      }
      .site-footer {
        border-top: 1px solid var(--border);
        color: var(--fg-muted);
        font-size: var(--step--1);
        margin-top: 4rem;
      }
      .site-footer .container {
        padding: 2rem var(--pad-x);
      }
      .foot-brand {
        color: var(--fg-muted);
        font-weight: 600;
        letter-spacing: -0.01em;
      }
    </style>
  </body>
</html>
